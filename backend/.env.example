APP_NAME=PocketPal API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://pocketpal:pocketpal@localhost:5433/pocketpal

# REQUIRED. Generate a development secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production this must be >= 32 characters and supplied securely (never committed).
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
