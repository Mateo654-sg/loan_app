# Local development database used by docker-compose.yml
# These values are NOT production secrets; they only provision the local dev container.
POSTGRES_DB=pocketpal
POSTGRES_USER=pocketpal
POSTGRES_PASSWORD=pocketpal
# Host port for PostgreSQL. 5433 is used because 5432 may already be
# taken by a system-wide PostgreSQL installation on the developer machine.
POSTGRES_PORT=5433
